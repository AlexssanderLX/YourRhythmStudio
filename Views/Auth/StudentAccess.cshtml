@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Acesso do aluno";
}

<main class="auth-shell">
    <section class="auth-card" aria-labelledby="student-access-title">
        <a href="/" class="auth-back">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Voltar ao inicio
        </a>

        <div class="auth-brand">
            <img src="~/img/logo-mark.svg" alt="YourRhythm Studio" />
            <span>YourRhythm<span>.</span></span>
        </div>

        <div class="auth-copy">
            <p class="auth-kicker">Acesso do aluno</p>
            <h1 id="student-access-title">Abra seu link de aluno</h1>
            <p>Aluno nao entra com e-mail e senha. Use o link ou QR Code enviado pelo professor para acessar suas missoes, repertorio e progresso.</p>
        </div>

        <div class="auth-validation" role="status">
            Se voce ja recebeu o link, abra-o novamente neste navegador. Se ainda nao recebeu, peca ao professor para gerar um novo acesso.
        </div>
    </section>
</main>
